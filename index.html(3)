<script>
tailwind.config={theme:{extend:{fontFamily:{display:['"Barlow Condensed"','Arial Narrow','sans-serif'],sans:['Barlow','system-ui','sans-serif']},colors:{pitch:{50:'#effaf1',100:'#d7f1dc',500:'#1f9d55',600:'#168044',700:'#146637',900:'#0c3b22'},board:'#0e2238'}}}}
